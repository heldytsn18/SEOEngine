# ==============================================================================
# BorneoFlash SEO Engine Microservice - Environment Configuration (Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 9Router AI Gateway Configuration
# ------------------------------------------------------------------------------
# URL endpoint 9Router AI Gateway (Local proxy: http://localhost:20128/... atau Cloud: https://api.ninerouter.com/...)
NINEROUTER_URL=https://api.ninerouter.com/v1/chat/completions

# API Key autentikasi 9Router Gateway
NINEROUTER_API_KEY=

# Model AI Aktif (Contoh: ag/gemini-3.8-flash-high, ag/gemini-pro-agent, ag/claude-sonnet-4-6)
NINEROUTER_MODEL=ag/gemini-3.8-flash-high

# Timeout panggilan AI dalam detik
NINEROUTER_TIMEOUT=60

# ------------------------------------------------------------------------------
# Microservice Server Configuration
# ------------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ------------------------------------------------------------------------------
# API Authentication (Opsional)
# ------------------------------------------------------------------------------
# Jika diisi, semua request harus menyertakan header X-API-Key
# Kosongkan untuk menonaktifkan autentikasi (development mode)
SEO_API_KEY=

# ------------------------------------------------------------------------------
# Google Cloud Service Account & Search Console (v3.0)
# ------------------------------------------------------------------------------
# Path ke file service account JSON (untuk Google Instant Indexing & GSC API)
# Contoh: /path/to/borneoflash-analytics-26fc49979c1d.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Properti Google Search Console untuk BorneoFlash
GSC_SITE_URL=sc-domain:borneoflash.com
